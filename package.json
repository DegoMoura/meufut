{
  "name": "meufut-tools",
  "private": true,
  "version": "1.0.0",
  "description": "Scripts auxiliares do MeuFut (migração de dados, empacotamento nativo). O app em si continua sendo index.html puro — nada disso entra na versão web.",
  "scripts": {
    "migrar:teste": "node migrar-para-multitenant.js --dry-run",
    "migrar": "node migrar-para-multitenant.js --write",
    "limpar-demo:teste": "node limpar-jogadores-demo.js --dry-run",
    "limpar-demo": "node limpar-jogadores-demo.js --write",
    "limpar-demo:tudo": "node limpar-jogadores-demo.js --write --incluir-candidatos",
    "sync:www": "node sync-www.js",
    "cap:sync": "npm run sync:www && npx cap sync"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  }
}
